# TomTom anahtarı — boş bırakılırsa demo trafik verisi üretilir
TOMTOM_API_KEY=buraya_tomtom_anahtarinizi_yazin

# EGO canlı otobüs servisi (belgelenmemiş). Boşsa demo otobüsler gösterilir.
EGO_API_BASE=

# Virgülle birden fazla origin verilebilir
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://traffic:traffic_pass@localhost:5432/ankara_traffic

# İsteğe bağlı
# TRAFFIC_REFRESH_SECONDS=180   # TomTom ücretsiz kotası (2.500/gün) için
# BUS_REFRESH_SECONDS=30
# TRAFFIC_DEMO=auto             # auto | on | off
# RETENTION_DAYS=30             # geçmiş kayıt saklama süresi
